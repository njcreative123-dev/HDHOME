# =============================================================================
# HDHome Live TV - Apache / LiteSpeed configuration
# =============================================================================

Options -Indexes
DirectoryIndex index.php

<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=()"
</IfModule>

<FilesMatch "^(\.env|\.env\.example|.*\.(sql|md|log|ini|bak))$">
    Require all denied
</FilesMatch>

RewriteEngine On
RewriteRule ^(includes|database|sql|src|tools|templates|logs|tmp)(/|$) - [F,L,NC]
RewriteRule (^\.|/\.) - [F,L]

RewriteRule ^api/?$ api.php [L,QSA]
RewriteRule ^api/([a-z0-9_/\-]+)/?$ api.php?endpoint=$1 [L,QSA]

<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/css application/javascript application/json image/svg+xml
</IfModule>

<IfModule mod_expires.c>
    ExpiresActive On
    ExpiresByType image/svg+xml "access plus 7 days"
    ExpiresByType text/css "access plus 7 days"
    ExpiresByType application/javascript "access plus 7 days"
</IfModule>
