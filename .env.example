# =============================================================================
# HDHome Live TV - Environment Configuration
# =============================================================================
# 1. FTP par yah file ".env" naam se copy karein (root directory mein).
# 2. InfinityFree MySQL details panel se bharin.
# 3. AI key apni sk-or-v1-... key se replace karein.
# =============================================================================

# --- Site -------------------------------------------------------------------
SITE_NAME=HDHome Live TV
SITE_URL=https://hdhome.free.je

# --- Database (InfinityFree MySQL) -------------------------------------------
DB_HOST=sql112.infinityfree.com
DB_NAME=if0_42677262_hdhome
DB_USER=if0_42677262
DB_PASS=change-me
DB_CHARSET=utf8mb4

# --- Admin panel -------------------------------------------------------------
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-to-a-strong-password
ADMIN_PASSWORD_HASH=

# --- OpenRouter AI Agent -----------------------------------------------------
OPENROUTER_API_KEY=sk-or-v1-your-new-key-here
AI_MODEL=openrouter/auto

# --- Security ----------------------------------------------------------------
SESSION_SECRET=change-me-to-a-long-random-string
ALLOWED_ORIGINS=*

# --- Maintenance -------------------------------------------------------------
LOG_RETENTION_DAYS=30
LOG_CLEANUP_INTERVAL=7200

# --- Debug -------------------------------------------------------------------
APP_DEBUG=false
